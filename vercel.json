{
  "version": 2,
  "public": true,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "core.adrian-clements.com"
        }
      ],
      "dest": "/core/index.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "core.adrian-clements.com"
        }
      ],
      "dest": "/core/$1"
    },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
