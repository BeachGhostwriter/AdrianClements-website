# Website contact API (Vercel)
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=contact@example.com
SMTP_PASS=<set-secret>
SMTP_FROM=contact@example.com
CONTACT_TO=owner@example.com
CONTACT_ALLOWED_ORIGIN=https://your-domain.example

# CORE access gateway API (Vercel)
CORE_ACCESS_CODE=<set-secret>
CORE_LIVE_URL=https://core.your-domain.example/login
CORE_DEMO_URL=/core.html
CORE_ALLOWED_ORIGIN=https://your-domain.example