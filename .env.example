# Website contact API (Vercel)
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=contact@example.com
SMTP_PASS=<set-secret>
SMTP_FROM=contact@example.com
CONTACT_TO=owner@example.com
CONTACT_ALLOWED_ORIGIN=https://your-domain.example

# CORE auth gate (Vercel functions, core.adrian-clements.com)
# Reuses the same Neon Postgres "User" table as Corewebsite/core-risk-platform
# (falls back to DATABASE_URL if CORE_DATABASE_URL is unset).
CORE_DATABASE_URL=<set-secret>
CORE_SESSION_SECRET=<set-secret>